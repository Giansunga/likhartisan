# LikhArtisan server environment variables
# Copy this file to .env and fill in your values. Never commit the actual .env file.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# PayMongo
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret

# Groq AI (existing LikhAI chatbot)
GROQ_API_KEY=gsk_your_groq_api_key

# AI gallery search. Keep auto top-up disabled in the Gateway dashboard.
AI_GATEWAY_API_KEY=your_gateway_key
AI_SEARCH_MODEL=alibaba/qwen3.5-flash
AI_GALLERY_SEARCH_ENABLED=false

# Lalamove
LALAMOVE_API_KEY=pk_test_your_key
LALAMOVE_API_SECRET=sk_test_your_secret
LALAMOVE_MARKET=PH

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

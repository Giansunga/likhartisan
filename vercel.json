{
  "buildCommand": "cd gallery-app && npm install && npm run build",
  "outputDirectory": "gallery-app/dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": { "eq": "likhartisan.vercel.app" } }],
      "destination": "https://likhartisan.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": { "eq": "www.likhartisan.com" } }],
      "destination": "https://likhartisan.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/media/:path*", "destination": "https://likhartisan-assets.likhartisan-assets.workers.dev/:path*" },
    { "source": "/((?!api/|media/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/media/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "1" }]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Type", "value": "video/mp4" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
